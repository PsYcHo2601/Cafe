<+><!DOCTYPE html>\r\n{% load static %}\r\n<html>\r\n    <head>\r\n        <meta charset=\"UTF-8\">\r\n        <meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\">\r\n        <title>{% block title %}Vlado`s Coffee{% endblock %}</title>\r\n        <link rel=\"stylesheet\" href=\"{% static 'css/styles.css' %}?t={{ now|date:'U' }}\">\r\n        <link rel=\"preconnect\" href=\"https://fonts.googleapis.com\">\r\n        <link rel=\"preconnect\" href=\"https://fonts.gstatic.com\" crossorigin>\r\n        <link href=\"https://fonts.googleapis.com/css2?family=Aboreto&family=Gidole&family=Inter:ital,opsz,wght@0,14..32,100..900;1,14..32,100..900&display=swap\" rel=\"stylesheet\">\r\n        {% block extra_css %}{% endblock %}  <!-- Для дополнительных CSS -->\r\n    </head>\r\n    <body>\r\n        <div class=\"home\">\r\n            <!-- Хедер -->\r\n            <div class=\"header\">\r\n                <div class=\"logo_group\">\r\n                    <a href=\"{% url 'coffee:table_list' %}\"><img class=\"logo\" src=\"http://127.0.0.1:9000/cafe/main_image.png\" alt=\"Vlados-coffee-image\"></a>\r\n                    <p class=\"name\">Vlado`s coffee</p>\r\n                </div>\r\n                <!-- Меню навигации -->\r\n                <div class=\"links_group\">\r\n                    <a href=\"{% url 'coffee:table_list' %}\" class=\"main_links\"><h1>Столики</h1></a>\r\n                    <a href=\"{% url 'coffee:product_list' %}\" class=\"main_links\"><h1>Меню</h1></a>\r\n\r\n                    <!-- Уведомления -->\r\n                    {% if messages %}\r\n                    <div class=\"messages\">\r\n                        {% for message in messages %}\r\n                        <div class=\"alert alert-{{ message.tags }}\">\r\n                            {{ message }}\r\n                        </div>\r\n                        {% endfor %}\r\n                    </div>\r\n                    {% endif %}\r\n\r\n                    <ul>\r\n                        <li class=\"root\">\r\n                            <h1>Контакты</h1>\r\n                            <ul class=\"dropdown\">\r\n                                <li><a href=\"https://web.telegram.org/a/\"><img src=\"http://127.0.0.1:9000/cafe/tg.png\" alt=\"telegram\"></a></li>\r\n                                <li><a href=\"https://vk.com/vladospapiross\"><img src=\"http://127.0.0.1:9000/cafe/vk.png\" alt=\"vk\"></a></li>\r\n                                <li><a href=\"tel:+79296049780\"><img src=\"http://127.0.0.1:9000/cafe/whatsapp.png\" alt=\"whatsapp\"></a></li>\r\n                                <li><a href=\"mailto:sedvlad2015@yandex.ru\"><img src=\"http://127.0.0.1:9000/cafe/email.png\" alt=\"mail\" style=\"width: 40px;\"></a></li>\r\n                            </ul>\r\n                        </li>\r\n                    </ul>\r\n                </div>\r\n            </div>\r\n            <!-- Контент -->\r\n            <div class=\"content\">\r\n                {% block content %}{% endblock %}\r\n            </div>\r\n\r\n            <!-- Футер -->\r\n            <footer class=\"footer\">\r\n                <p>© 2023 Vlado`s Coffee. Все права защищены.</p>\r\n                {% if user.is_authenticated %}\r\n                <p>Вы вошли как: {{ user.username }} | <a href=\"{% url 'admin:logout' %}\">Выйти</a></p>\r\n                {% endif %}\r\n            </footer>\r\n        </div>\r\n\r\n        {% block extra_js %}{% endblock %}  <!-- Для дополнительных JS -->\r\n    </body>\r\n</html>
